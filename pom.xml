<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot's parent is used only for its dependency/plugin version management;
         modules that are not Spring applications (core, task-api, worker, benchmarks) do not use Spring. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.queuepilot</groupId>
    <artifactId>queuepilot-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>QueuePilot</name>
    <description>Extensible job scheduling and execution platform</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <modules>
        <module>queuepilot-task-api</module>
        <module>queuepilot-core</module>
        <module>queuepilot-tasks-builtin</module>
        <module>queuepilot-example-plugin</module>
        <module>queuepilot-coordinator</module>
        <module>queuepilot-worker</module>
        <module>queuepilot-benchmarks</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.queuepilot</groupId>
                <artifactId>queuepilot-task-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.queuepilot</groupId>
                <artifactId>queuepilot-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.queuepilot</groupId>
                <artifactId>queuepilot-tasks-builtin</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
