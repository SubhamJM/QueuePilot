<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.queuepilot</groupId>
        <artifactId>queuepilot-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>queuepilot-worker</artifactId>
    <name>QueuePilot Worker</name>
    <description>Independent worker process: claims assignments, runs task plugins, reports results.</description>

    <dependencies>
        <dependency>
            <groupId>com.queuepilot</groupId>
            <artifactId>queuepilot-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.queuepilot</groupId>
            <artifactId>queuepilot-task-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.queuepilot</groupId>
            <artifactId>queuepilot-tasks-builtin</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.queuepilot.worker.WorkerMain</mainClass>
                    <!-- Executable jar is queuepilot-worker-1.0.0-exec.jar; the plain jar stays usable as a
                         dependency (the coordinator's end-to-end tests run real workers in-process). -->
                    <classifier>exec</classifier>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
