<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.queuepilot</groupId>
        <artifactId>queuepilot-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>queuepilot-coordinator</artifactId>
    <name>QueuePilot Coordinator</name>
    <description>REST API, persistence, scheduling, recovery and dashboard. Never executes task code.</description>

    <dependencies>
        <dependency>
            <groupId>com.queuepilot</groupId>
            <artifactId>queuepilot-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Real worker runtime for end-to-end tests against a running coordinator. -->
        <dependency>
            <groupId>com.queuepilot</groupId>
            <artifactId>queuepilot-worker</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Real PostgreSQL binaries for one integration test, without installing PostgreSQL. -->
        <dependency>
            <groupId>io.zonky.test</groupId>
            <artifactId>embedded-postgres</artifactId>
            <version>2.0.7</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- Built-in task manifests are seeded into the registry at startup.
                 Copying the JSON (not the code) keeps the coordinator free of plugin classes. -->
            <resource>
                <directory>../queuepilot-tasks-builtin/src/main/resources/META-INF/queuepilot/tasks</directory>
                <targetPath>seed-tasks</targetPath>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
